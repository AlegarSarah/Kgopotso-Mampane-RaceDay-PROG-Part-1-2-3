@model ProfileVm
@{
    ViewData["Title"] = "My profile";
}
<h1 class="rd-title">My profile</h1>
<div class="row g-4">
    <div class="col-md-4 text-center">
        @if (!string.IsNullOrEmpty(Model.ProfilePictureUrl))
        {
            <img src="@Model.ProfilePictureUrl" class="rd-avatar" alt="Profile picture" />
        }
        else
        {

            <div class="rd-avatar rd-avatar-empty">@(Model.FirstName.Length > 0 ? Model.FirstName[0].ToString().ToUpper() : "?")</div>
        }
        <form asp-controller="Participant" asp-action="UploadPicture" method="post" enctype="multipart/form-data" class="mt-3">
            <input type="file" name="file" accept="image/*" class="form-control mb-2" />
            <button class="btn btn-outline-dark w-100" type="submit">Upload picture</button>
        </form>
    </div>
    <div class="col-md-8">
        <form asp-controller="Participant" asp-action="Profile" method="post" class="rd-form">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <input type="hidden" asp-for="ProfilePictureUrl" />
            <div class="mb-3"><label class="form-label">Email</label><input asp-for="Email" class="form-control" readonly /></div>
            <div class="mb-3"><label asp-for="FirstName" class="form-label"></label><input asp-for="FirstName" class="form-control" /><span asp-validation-for="FirstName" class="text-danger"></span></div>
            <div class="mb-3"><label asp-for="LastName" class="form-label"></label><input asp-for="LastName" class="form-control" /><span asp-validation-for="LastName" class="text-danger"></span></div>
            <div class="mb-3"><label asp-for="PhoneNumber" class="form-label"></label><input asp-for="PhoneNumber" class="form-control" /></div>
            <button class="btn btn-rd" type="submit">Save changes</button>
        </form>
    </div>
</div>